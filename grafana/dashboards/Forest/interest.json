{
  "uid": "myc-interest",
  "title": "Interest & buzz",
  "description": "Public interest in mushrooms (Polish Wikipedia), social buzz (Mastodon) and the global biodiversity index (GBIF).",
  "tags": [
    "mycelium",
    "interest"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "monday",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "article",
        "label": "Wikipedia article",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(wiki_pageviews_latest, name_pl)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(wiki_pageviews_latest, name_pl)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Mycelium",
      "type": "dashboards",
      "tags": [
        "mycelium"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Wikipedia page views per day · last 14 days (from a single scrape)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name_pl, day) (last_over_time(wiki_pageviews_daily{name_pl=~\"$article\"}[20m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "day\\name_pl",
        "showValue": "never",
        "stacking": "normal",
        "groupWidth": 0.8,
        "barWidth": 0.9,
        "barRadius": 0,
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 100,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "json-exporter emits the last 14 days of every article as series with a `day` label, so two weeks of history are there from the first scrape. Transformations: day YYYYMMDD00 → time, then 'Grouping to matrix' (rows = days, columns = articles).",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "name_pl",
            "rowField": "day",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "day\\name_pl",
                "destinationType": "time",
                "dateFormat": "YYYYMMDDHH"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day\\name_pl",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Interest spike · yesterday vs 14-day mean",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(forest:wiki_interest:spike_ratio{name_pl=~\"$article\"})",
          "legendFormat": "{{name_pl}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5794F2",
                "value": null
              },
              {
                "color": "#FADE2A",
                "value": 1.5
              },
              {
                "color": "#FF9830",
                "value": 2
              },
              {
                "color": "#E02F44",
                "value": 3
              }
            ]
          },
          "min": 0,
          "max": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300,
        "legend": {
          "showLegend": false
        }
      },
      "description": "1.0 = a normal day. Above 2 for 'grzyby trujące' (poisonous mushrooms) triggers the PoisoningInterestSpike notice — interest jumps after poisoning news."
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Hype index · Wikipedia readers per new field observation",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(forest:hype:pageviews_per_observation)",
          "legendFormat": "{{name_pl}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300,
        "legend": {
          "showLegend": false
        }
      },
      "description": "Yesterday's page views ÷ (new observations in 24 h + 1). The fly agaric is famous far beyond the forest; boletes are simply picked."
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Mastodon hashtags per day (mastodon.social)",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tag, day) (last_over_time(mastodon_tag_uses[15m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisBorderShow": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "day\\tag",
        "showValue": "never",
        "stacking": "normal",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "barRadius": 0,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Daily uses of each hashtag over the 7 days the API reports (the newest day is still running). #FungiFriday lives up to its name. Transformations: Grouping to matrix + epoch → time.",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "tag",
            "rowField": "day",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "day\\tag",
                "destinationType": "time",
                "dateFormat": "X"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day\\tag",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Wikipedia page views · last complete day",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name_pl) (last_over_time(forest:wiki_pageviews:latest{name_pl=~\"$article\"}[$__interval]))",
          "legendFormat": "{{name_pl}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0,
            "lineWidth": 1,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "barAlignment": 0,
            "insertNulls": false,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Daily data polled every 10 min: steps once a day when Wikimedia publishes yesterday. last_over_time() in the recording rule bridges the gaps between polls."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GBIF ÷ iNaturalist · how much of the citizen science reaches the global index",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(forest:gbif_to_inat:ratio[$__interval])",
          "legendFormat": "{{species}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0,
            "lineWidth": 1,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "barAlignment": 0,
            "insertNulls": false,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "GBIF records in Poland ÷ iNaturalist observations in Poland, per species. GBIF also holds museum and survey data, but iNaturalist casual/needs-ID records never get there."
    }
  ]
}
