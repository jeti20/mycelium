{
  "uid": "myc-home",
  "title": "Mycelium",
  "description": "Overview: mushroom season in Poland plus the health of the system watching it.",
  "tags": [
    "mycelium",
    "home"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "monday",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Mycelium",
      "type": "dashboards",
      "tags": [
        "mycelium"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:18px;padding:4px 8px\">\n<div style=\"font-size:42px\">🍄</div>\n<div><div style=\"font-size:22px;font-weight:600\">Mycelium · Poland's mushroom season, observed like production</div>\n<div style=\"opacity:.75\">Citizen-science observations (iNaturalist), public interest (Wikipedia), social buzz (Mastodon) and a biodiversity index (GBIF) —\ncollected with the OpenTelemetry Collector, held to SLOs written as code (Sloth), alerting by e-mail through Alertmanager.\n<a href=\"/d/myc-forest\">Forest</a> · <a href=\"/d/myc-interest\">Interest &amp; buzz</a> · <a href=\"/d/myc-slo\">SLOs</a> · <a href=\"/d/myc-platform\">Platform</a></div></div></div>",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Mushroom season index",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "forest:season_index:ratio",
          "legendFormat": "season",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6E6E6E",
                "value": null
              },
              {
                "color": "#FADE2A",
                "value": 0.25
              },
              {
                "color": "#96D98D",
                "value": 0.5
              },
              {
                "color": "#37872D",
                "value": 0.8
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      },
      "description": "New fungi observations reported in Poland in the last 24 h, as a share of a peak-season day (400/day, the October baseline from iNaturalist's own histogram). 0 = off-season, 100 % = peak."
    },
