{
  "uid": "myc-forest",
  "title": "Forest · what is growing",
  "description": "Species-level view of Poland's mushroom season from iNaturalist, with GBIF and Wikipedia alongside.",
  "tags": [
    "mycelium",
    "forest"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "monday",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "edibility",
        "label": "Edibility",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(inat_observations{scope=\"species\"}, edibility)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(inat_observations{scope=\"species\"}, edibility)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Mycelium",
      "type": "dashboards",
      "tags": [
        "mycelium"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "New observations in Poland · last 24 h",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(max by (species, name_pl, edibility, taxon_id) (forest:inat_new_observations:24h{scope=\"species\", edibility=~\"$edibility\"}) + on (species) group_left () (max by (species) (inat_observations{scope=\"species\"}) / 1e9))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "edible": {
                  "color": "#56A64B",
                  "index": 0,
                  "text": "edible"
                },
                "toxic": {
                  "color": "#FF9830",
                  "index": 1,
                  "text": "toxic"
                },
                "deadly": {
                  "color": "#E02F44",
                  "index": 2,
                  "text": "☠ deadly"
                },
                "topic": {
                  "color": "#5794F2",
                  "index": 3,
                  "text": "topic"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisBorderShow": false
          },
          "links": [
            {
              "title": "Species page on iNaturalist",
              "url": "https://www.inaturalist.org/taxa/${__data.fields.taxon_id}",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "taxon_id"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "species",
        "colorByField": "edibility",
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 0.75,
        "barWidth": 0.85,
        "barRadius": 0.1,
        "fullHighlight": false,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "New iNaturalist observations per species in the last 24 h. Colour = edibility. Ties are broken by the all-time total (added as total/1e9, invisible at 0 decimals) - without it, species with equal counts swapped places on every refresh.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "provider": true,
              "scope": true,
              "species": true
            },
            "renameByName": {
              "Value": "new · 24 h",
              "name_pl": "species"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reporting pace · observations per day (6 h linear trend)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name_pl) (forest:inat_pace:per_day{scope=\"species\", edibility=~\"$edibility\"})",
          "legendFormat": "{{name_pl}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 1,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "barAlignment": 0,
            "insertNulls": false,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "deriv() over 6 h × 86 400: how fast the total grows right now, in observations/day. Reacts within hours; the 24 h delta on the left is the stable view."
    },
    {
