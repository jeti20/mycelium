            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (sloth_id) (slo:sli_error:ratio_rate1h{sloth_service=~\"$service\"} / on (sloth_id) group_left slo:error_budget:ratio)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        },
        {
          "refId": "E",
