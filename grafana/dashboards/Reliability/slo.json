          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (sloth_id) (1 - slo:sli_error:ratio_rate30d{sloth_service=~\"$service\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (sloth_id) (slo:period_error_budget_remaining:ratio{sloth_service=~\"$service\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "interval": "1m"
        },
        {
          "refId": "D",
