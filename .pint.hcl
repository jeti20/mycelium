# pint - PromQL / rule linter (https://cloudflare.github.io/pint/)
#   docker compose run --rm pint
#
# House rules enforced on every alert, hand-written or generated by Sloth:
#   - severity in {none, ticket, page}  -> drives Alertmanager routing
#   - category in {slo, forest, data-quality, platform}
#   - a summary for the e-mail subject line
#   - anything that pages links to a runbook

rule {
  match {
    kind = "alerting"
  }
  label "severity" {
    severity = "bug"
    value    = "(none|ticket|page)"
    required = true
  }
  label "category" {
    severity = "bug"
    value    = "(slo|forest|data-quality|platform)"
    required = true
  }
  annotation "summary" {
    severity = "bug"
    required = true
  }
}

rule {
  match {
    kind = "alerting"
    label "severity" {
      value = "page"
    }
  }
  annotation "runbook_url" {
    severity = "bug"
    required = true
    value    = "https://github.com/jeti20/mycelium/blob/main/docs/runbooks.md#.+"
  }
}

# Uncomment to let pint also check rules against the running Prometheus
# (series exist, labels match, rate() only on counters ...):
#   docker compose run --rm pint pint --config=/work/.pint.hcl lint /work/prometheus/rules
# with the container attached to the compose network.
# prometheus "local" {
#   uri     = "http://prometheus:9090"
#   timeout = "30s"
# }

# Sloth puts SLI recordings, budget metadata and alerts into separate rule
# groups by design, and our building blocks (sli.yml) feed Sloth's groups.
# Cross-group dependencies are intentional here, so this check is noise.
checks {
  disabled = ["rule/dependency"]
}
